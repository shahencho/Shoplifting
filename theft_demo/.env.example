# Copy to theft_demo/.env and fill in. theft_demo/.env is gitignored.
VLM_API_URL=https://openrouter.ai/api/v1
VLM_API_KEY=
# Same bot as fire: never run the fire app and the theft demo at the same time (Telegram allows one poller per bot).
TELEGRAM_BOT_TOKEN=
# Qwen verification: on / off. --no-qwen also turns it off.
THEFT_QWEN=on
# Dashboard login. Locally a random password is printed if empty.
DEMO_USER=admin
DEMO_PASSWORD=
