# Copy to fire/.env and fill in. fire/.env is gitignored.
VLM_API_URL=https://openrouter.ai/api/v1
VLM_API_KEY=
TELEGRAM_BOT_TOKEN=
# Hugging Face read token, only for gated models in fire/models/download.py --candidates
HF_TOKEN=
# Qwen verification: on / off (droplet: fire/deploy/qwen.sh on|off). --no-qwen also turns it off.
FIRE_QWEN=on
# Dashboard login. Required on the droplet (public internet); locally a random password is printed if empty.
DEMO_USER=admin
DEMO_PASSWORD=
